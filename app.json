{
  "expo": {
    "name": "Nur Quran",
    "slug": "nur-quran",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nurquran",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "We use your location to calculate the Qibla direction.",
        "NSCameraUsageDescription": "Camera access is not required."
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-splash-screen",
      "expo-status-bar",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "We use your location to calculate the Qibla direction."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
